# Public Firebase Web SDK values for this static application.
# Copy the same values into firebase-config.js (from firebase-config.example.js).
KEYSTROKE_FIREBASE_API_KEY="YOUR_API_KEY"
KEYSTROKE_FIREBASE_AUTH_DOMAIN="YOUR_AUTH_DOMAIN"
KEYSTROKE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
KEYSTROKE_FIREBASE_APP_ID="YOUR_APP_ID"
